<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3: o projeto de testes é um executável (roda sozinho ou via "dotnet test"). -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 pede repassar TestContext.Current.CancellationToken a cada chamada. As requisições vão
         para um servidor em memória e terminam em milissegundos: o ganho não compensa poluir os testes. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- xUnit v3 roda sobre a Microsoft.Testing.Platform (ativada no global.json). -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JpHelpDesk.Api\JpHelpDesk.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
