# Copie para ".env" e preencha. O .env está no .gitignore: nunca faça commit dele.

# Senha do usuário "sa" do SQL Server do contêiner. Regras do SQL Server: 8+ caracteres com
# maiúscula, minúscula, número e símbolo. Evite ";" (separador da connection string).
SQL_SA_PASSWORD=

# Chave de assinatura dos tokens JWT: no mínimo 32 caracteres aleatórios. Para gerar:
#   PowerShell: $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 64 | tr -d '\n'
JWT_CHAVE_SECRETA=

# Senha dos usuários de teste (admin@, tecnico@ e usuario@jphelpdesk.com).
SENHA_USUARIOS_TESTE=

# Porta do navegador (opcional, padrão 8080).
# PORTA_WEB=8080
